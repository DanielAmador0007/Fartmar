# =============================================================================
# FARTMAR — variables de entorno de docker-compose (raíz del repositorio)
# Uso:  cp .env.example .env   y luego   docker compose up -d --build  (o make up)
# Este archivo NO contiene secretos reales: los valores son solo para demo
# local. El .env real está en .gitignore y nunca se commitea.
# =============================================================================

# --- Base de datos (PostgreSQL 16) -------------------------------------------
POSTGRES_DB=fartmar
POSTGRES_USER=fartmar
# Clave SOLO para el entorno local de demo. Cámbiela en cualquier otro entorno.
POSTGRES_PASSWORD=fartmar_local_demo
# Puerto del host para conectarse desde fuera de Docker (DBeaver, psql...).
DB_HOST_PORT=55432

# --- API (Laravel) -------------------------------------------------------------
API_HOST_PORT=8080
APP_ENV=local
APP_DEBUG=true
# APP_KEY no se define aquí: el entrypoint la genera en backend/.env si falta
# (solo demo). En producción se inyecta como secreto del orquestador.

# --- Frontend (Vite, en el host) ---------------------------------------------------
FRONTEND_HOST_PORT=5173

# --- Reglas de negocio ---------------------------------------------------------
# RN-11: días de anticipación para alertar vencimientos
ALERT_EXPIRY_DAYS=90

# --- Asistente IA --------------------------------------------------------------
# mock (por defecto, no requiere llaves) | ollama | anthropic | openai
LLM_PROVIDER=mock
