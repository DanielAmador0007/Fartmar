# =============================================================================
# FARTMAR — variables de entorno de docker-compose (raíz del repositorio)
#
#   cp .env.example .env && docker compose up -d --build --wait     (o make up)
#   -> http://localhost:8080
#
# Este archivo NO contiene secretos reales: los valores son solo para la demo
# local. El .env real está en .gitignore y nunca se commitea. En cualquier otro
# entorno, cada clave/llave sale del gestor de secretos (docs/DEPLOY.md).
# =============================================================================

# --- Modo demo -------------------------------------------------------------------
# true = si APP_KEY o PATIENT_HASH_KEY están vacías, el servicio migrate las
# genera UNA vez en el volumen app_keys (se borran con `down -v`, junto con la
# BD). En producción: false y llaves definidas abajo. Con false y sin llaves,
# el arranque falla con un mensaje claro.
ALLOW_GENERATED_KEYS=true
# true = siembra usuarios y datos SINTÉTICOS de demostración (contraseña
# "password"; ver docs/modelo-datos.md). Nunca true en producción.
SEED_DEMO_DATA=true

# --- Llaves (secretos) --------------------------------------------------------------
# Vacías en la demo (ver ALLOW_GENERATED_KEYS). Para definirlas:
#   docker run --rm php:8.4-cli-alpine php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
# Cambiarlas después invalida los documentos cifrados y los hashes de búsqueda
# de pacientes (no hay rutina de re-cifrado).
APP_KEY=
PATIENT_HASH_KEY=

# --- Base de datos (PostgreSQL 16) -------------------------------------------
POSTGRES_DB=fartmar
# Dueño de las tablas: solo lo usa el servicio migrate (migraciones).
POSTGRES_USER=fartmar
# Clave SOLO para el entorno local de demo. Cámbiela en cualquier otro entorno.
POSTGRES_PASSWORD=fartmar_local_demo
# Rol con el que corren api y scheduler: no es dueño de las tablas, no puede
# hacer TRUNCATE ni DDL, y kardex y bitácoras son de solo inserción (S-101).
DB_APP_USERNAME=fartmar_app
DB_APP_PASSWORD=fartmar_app_local_demo
# false (demo) = migrate crea el rol y le fija la clave en cada despliegue (el
# dueño necesita superusuario o CREATEROLE). true = el rol y su clave los crea
# el DBA/proveedor de la BD y migrate solo aplica GRANT/REVOKE (S-112).
DB_APP_ROLE_MANAGED_EXTERNALLY=false
# Puerto del host (solo 127.0.0.1) para DBeaver/psql.
DB_HOST_PORT=55432

# --- Web / API -------------------------------------------------------------------
# Nginx: SPA + API en el mismo origen. El Vite de desarrollo hace proxy a este puerto.
WEB_HOST_PORT=8080
# info en el stack tipo producción (el override de desarrollo usa debug).
LOG_LEVEL=info
# Vacío = no confiar en ningún proxy (correcto detrás de Nginx con FastCGI).
# Solo para un proxy HTTP delante de PHP: IPs/CIDR separadas por coma (S-100).
TRUSTED_PROXIES=
# Vida de los tokens Bearer en minutos (480 = un turno de 8 h).
SANCTUM_EXPIRATION=480
# Orígenes de OTRO dominio que pueden llamar la API (separados por coma). Vacío:
# la SPA se sirve en el mismo origen. El override de desarrollo agrega el Vite.
CORS_ALLOWED_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120

# --- Reglas de negocio ---------------------------------------------------------
# RN-11: días de anticipación para alertar vencimientos
ALERT_EXPIRY_DAYS=90

# --- Asistente IA --------------------------------------------------------------
# mock (por defecto: determinista, sin red ni llaves) | ollama | anthropic
LLM_PROVIDER=mock
# Ollama local (modelo con tool calling). Desde el contenedor, el host es host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Anthropic (externo). La llave va SOLO en el .env real, nunca en el repo.
LLM_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Segundos por llamada al modelo, tokens por respuesta y preguntas por minuto por usuario.
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024
ASSISTANT_RATE_LIMIT_PER_MINUTE=10

# --- Imágenes (CI/CD) ------------------------------------------------------------
# Vacías = se construyen localmente (fartmar-api:local, fartmar-web:local). En
# un despliegue se fijan a la imagen inmutable del commit, p. ej.
#   API_IMAGE=ghcr.io/<owner>/fartmar-api:<sha>  WEB_IMAGE=ghcr.io/<owner>/fartmar-web:<sha>
API_IMAGE=
WEB_IMAGE=
