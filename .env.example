# =============================================================================
# FARTMAR — variables de entorno de docker-compose (raíz del repositorio)
# Uso:  cp .env.example .env   y luego   docker compose up -d --build  (o make up)
# Este archivo NO contiene secretos reales: los valores son solo para demo
# local. El .env real está en .gitignore y nunca se commitea.
# =============================================================================

# --- Base de datos (PostgreSQL 16) -------------------------------------------
POSTGRES_DB=fartmar
POSTGRES_USER=fartmar
# Clave SOLO para el entorno local de demo. Cámbiela en cualquier otro entorno.
POSTGRES_PASSWORD=fartmar_local_demo
# Puerto del host para conectarse desde fuera de Docker (DBeaver, psql...).
DB_HOST_PORT=55432

# --- API (Laravel) -------------------------------------------------------------
API_HOST_PORT=8080
APP_ENV=local
APP_DEBUG=true
# APP_KEY no se define aquí: el entrypoint la genera en backend/.env si falta
# (solo demo). En producción se inyecta como secreto del orquestador.
# Logs: "json" = una línea JSON por registro a stderr, con correlation_id y
# datos personales redactados (RN-10). "stderr" = texto plano (también redactado).
LOG_CHANNEL=json

# --- Frontend (Vite, en el host) ---------------------------------------------------
FRONTEND_HOST_PORT=5173

# --- Reglas de negocio ---------------------------------------------------------
# RN-11: días de anticipación para alertar vencimientos
ALERT_EXPIRY_DAYS=90

# --- Asistente IA --------------------------------------------------------------
# mock (por defecto: determinista, sin red ni llaves) | ollama | anthropic
LLM_PROVIDER=mock
# Ollama local (modelo con tool calling). Desde el contenedor, el host es host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Anthropic (externo). La llave va SOLO en el .env real, nunca en el repo.
LLM_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Segundos por llamada al modelo y preguntas por minuto por usuario.
LLM_TIMEOUT=30
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
