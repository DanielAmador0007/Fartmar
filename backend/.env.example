# Plantilla de configuración del backend (Laravel).
# En Docker, las variables DB_*, APP_ENV, LLM_* etc. llegan desde
# docker-compose.yml (que lee el .env de la RAÍZ) y tienen prioridad sobre este
# archivo. Este .env.example solo aporta valores por defecto.
# NO poner secretos reales aquí.

APP_NAME=FARTMAR
APP_ENV=local
# Se genera automáticamente en el entrypoint si está vacío (solo demo).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# "db" es el nombre del servicio en docker-compose. Fuera de Docker: 127.0.0.1 y DB_PORT=55432
DB_HOST=db
DB_PORT=5432
DB_DATABASE=fartmar
DB_USERNAME=fartmar
DB_PASSWORD=

# API stateless con tokens Sanctum: no se usan sesiones de servidor.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Asistente IA: mock (por defecto, sin llaves) | ollama | anthropic | openai
LLM_PROVIDER=mock

# Días para alerta de vencimiento (RN-11)
ALERT_EXPIRY_DAYS=90
